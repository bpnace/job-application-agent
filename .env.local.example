OPENAI_API_KEY=
AGENT_MODEL=gpt-5.4-mini
AGENT_MAX_OUTPUT_TOKENS=1800
AGENT_TRACING_DISABLED=true

# Default broad discovery run. Override downward for quick tests.
JOB_AGENT_LIVE_MAX_CANDIDATES=220
JOB_AGENT_HOST_DELAY_SECONDS=0.5
ENABLE_GOOGLE_JOBS_BROWSER=false

# Google organic search uses SerpApi via .env.
# Keep the real SerpApi key out of committed example files.
SERPAPI_MAX_QUERIES_PER_RUN=6

# Local runtime state. `job-agent init` writes an ignored candidate.yaml.
JOB_AGENT_HOME=.job-agent
JOB_AGENT_PROFILE_PATH=.job-agent/candidate.yaml
# Optional temporary overrides for document paths; keep real values local.
JOB_AGENT_CV_PDF_PATH=""
JOB_AGENT_CV_TEXT_PATH=""
JOB_AGENT_HUMANIZER_PATH=""

# Mail drafting. The agent writes NOT SENT drafts by default.
# Apple Mail can create a visible draft locally when the Outlook account is configured in Apple Mail.
JOB_AGENT_MAIL_SENDER="you@example.com"
JOB_AGENT_MAIL_MODE="draft_only"

# Future Outlook Graph send integration. Do not use until OAuth is configured and a per-email send approval exists.
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
OUTLOOK_SENDER="you@example.com"
